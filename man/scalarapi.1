.SH "SHELL COMPLETION"
scalarapi completion <shell> prints a completion script for bash, zsh, and fish. Load it from your shell startup file:
.PP
.RS 4
.nf
eval "$(scalarapi completion bash)"
eval "$(scalarapi completion zsh)"
scalarapi completion fish | source
.fi
.RE
